# ── 后端 FastAPI（Render）──
# SSE 进度直连用（浏览器端）
NEXT_PUBLIC_API_BASE=https://value-agent-api.onrender.com
# BFF 代理目标（服务端，与 NEXT_PUBLIC_API_BASE 通常同值）
API_BASE_SERVER=https://value-agent-api.onrender.com

# ── Supabase（新版 API Keys，2026 起推荐）──
# 项目地址：https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key（sb_publishable_...）——浏览器端安全，替代 legacy 的 anon
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key（sb_secret_...）——仅服务端使用（Route Handler / Server Action / 管理员操作），
# 替代 legacy 的 service_role；绝不可暴露到浏览器或前端代码
SUPABASE_SECRET_KEY=

# ── LLM 配置加密（M2）──
# 任意长度口令，用于 AES-256-GCM 加密 user_llm_settings.api_key_enc
# 本地与 Vercel 生产必须配置为相同值，否则无法解密已存 Key
LLM_SETTINGS_ENCRYPTION_KEY=
