# 数据源（全部免费：AkShare，无需 token）
# 数据库（Supabase Pooler 连接串，见 docs/07-deployment-guide.md §2）
DATABASE_URL=
# 会话库：sqlite（默认，data/sessions.db）| supabase（生产，用 DATABASE_URL 存 Supabase）| memory
SESSION_STORE=sqlite
# 本地 SQLite 路径（SESSION_STORE=sqlite 时生效）
SESSIONS_DB=data/sessions.db
# LLM
LLM_PROVIDER=deepseek                   # deepseek / openai / qwen / ollama
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
# CORS（前端域名白名单，逗号分隔；默认 *）
CORS_ORIGINS=*
# 监控通知（群机器人 Webhook，选配；配了哪个就推哪个）
# 飞书：群设置 → 群机器人 → 添加机器人 → 自定义机器人 → 复制 Webhook 地址
#       https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# 企微：群聊右上角 → 群机器人 → 添加 → 新建机器人 → 复制 Webhook 地址
#       https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxx
# 验证：value-agent notify --text "测试消息"
FEISHU_WEBHOOK=
WECHAT_WEBHOOK=
# FC 定时触发器调 POST /api/daily 的可选鉴权（设置后需带 x-daily-token 头）
DAILY_TOKEN=
# FC 全局鉴权（只允许前端登录用户调用 /api/*）：
# SUPABASE_URL  → 如 https://<project-ref>.supabase.co（用于拉 JWKS 验 ES256 token）

# SUPABASE_JWT_SECRET → 可选：轮换前的 HS256 老 token 回退验签（当前是 ECC 新 key 时可不配）
SUPABASE_URL=
SUPABASE_JWT_SECRET=
